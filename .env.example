# Codebase Intelligence Assistant - Environment Template
# Copy to .env and set OPENAI_API_KEY. Never commit .env.

# OpenAI (required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI models (optional; defaults shown)
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# Paths (optional; defaults under ./data)
REPOS_BASE=./data/repos
CHROMA_DIR=./data/indexes
LOG_DIR=./data/logs
TRACE_DIR=./data/traces

# CORS (optional)
ALLOWED_ORIGINS=http://localhost:3000
